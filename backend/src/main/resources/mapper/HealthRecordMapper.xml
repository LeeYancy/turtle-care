<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- 健康记录数据映射 -->
<mapper namespace="com.turtlecare.module.ai.repository.HealthRecordMapper">

    <!-- 结果映射：与 tc_health_record 表字段一一对应 -->
    <resultMap id="BaseResultMap" type="com.turtlecare.module.ai.model.HealthRecord">
        <id     column="id"             property="id" />
        <result column="user_id"        property="userId" />
        <result column="turtle_id"      property="turtleId" />
        <result column="symptoms"       property="symptoms" />
        <result column="environment"    property="environment" />
        <result column="ai_analysis"    property="aiAnalysis" />
        <result column="risk_level"     property="riskLevel" />
        <result column="recommendation" property="recommendation" />
        <result column="need_vet"       property="needVet" />
        <result column="llm_model"      property="llmModel" />
        <result column="llm_latency_ms" property="llmLatencyMs" />
        <result column="llm_cost"       property="llmCost" />
        <result column="user_rating"    property="userRating" />
        <result column="created_at"     property="createdAt" />
    </resultMap>

    <!-- 查询龟的最近N条健康记录 -->
    <select id="findRecentByTurtleId" resultMap="BaseResultMap">
        SELECT * FROM tc_health_record
        WHERE turtle_id = #{turtleId}
        ORDER BY created_at DESC
        LIMIT #{limit}
    </select>

    <!-- 查询用户的所有健康分析记录 -->
    <select id="findByUserId" resultMap="BaseResultMap">
        SELECT * FROM tc_health_record
        WHERE user_id = #{userId}
        ORDER BY created_at DESC
        LIMIT #{limit}
    </select>

</mapper>
