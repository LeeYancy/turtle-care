root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml}]
indent_size = 2

[*.{xml,html}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
max_line_length = off

[Makefile]
indent_style = tab

[*.{sh,bash}]
indent_size = 2
end_of_line = lf

# Java
[*.java]
indent_size = 4
max_line_length = 140

# Dart/Flutter
[*.dart]
indent_size = 2
max_line_length = 80

# Gradle
[*.gradle]
indent_size = 4

# Docker
[Dockerfile*]
indent_size = 4

# Git
[.git*]
indent_size = 2
